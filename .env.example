# Core
NEXT_PUBLIC_SITE_URL=https://tryamm.online
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only if a publishable key is unavailable:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Security / Quantum Security
# Server-only. Comma-separated authorized security operator user UUIDs.
SECURITY_ADMIN_USER_IDS=
# Server-only high-entropy HMAC key for hashing session/network risk signals.
SECURITY_RISK_HMAC_KEY=
# Emergency environment kill switch. Use true only during an active incident.
TRYAMM_PANIC_MODE=false

# AI / Stubbs AI provider adapter
AI_PROVIDER=
AI_API_KEY=
AI_PROVIDER_ENDPOINT=

